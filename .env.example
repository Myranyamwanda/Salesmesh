# Phase 1 local PostgreSQL settings. Copy to .env and replace the password.
# These are development defaults, not production credentials.
POSTGRES_DB=salesmesh
POSTGRES_USER=salesmesh_dev
POSTGRES_PASSWORD=replace_with_a_unique_local_password
POSTGRES_PORT=5432

# Phase 2 backend settings. Host/port connect from Windows to the container.
POSTGRES_HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT=5

# A separate database on the same server, using the same local credentials.
# Tests require this name to end in _test and differ from POSTGRES_DB.
TEST_POSTGRES_DB=salesmesh_test

# Phase 3 authentication. Generate the real secret without displaying it:
# backend/.venv/Scripts/python.exe backend/manage.py init-secret
# JWT_SECRET=replace_with_a_generated_secret_of_at_least_32_characters
JWT_ISSUER=salesmesh
JWT_AUDIENCE=salesmesh-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
VERIFICATION_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=30
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_FAILURE_LIMIT=5
ACCOUNT_LOCKOUT_MINUTES=15

# Fraud-detection model. Get the files for MODEL_SOURCE=local with
# `.\scripts\dev.ps1 fetch-model` (GitHub Release model-v1, SHA-256 checked).
# MODEL_SOURCE=local reads MODEL_DIR (relative paths
# are resolved from backend/; in Docker the folder is mounted at /app/models).
# MODEL_SOURCE=s3 downloads model.joblib, metadata.json, and golden_examples.json
# from MODEL_S3_BUCKET/MODEL_S3_PREFIX at startup. Use read-only credentials,
# and only a bucket you control: loading model.joblib executes pickled code.
# Leave the AWS keys empty to use the default AWS credential chain.
MODEL_SOURCE=local
MODEL_DIR=models/v1
# MODEL_S3_BUCKET=replace_with_your_bucket_name
MODEL_S3_PREFIX=models/final/v1
# AWS_REGION=replace_with_bucket_region
# AWS_ACCESS_KEY_ID=replace_with_read_only_access_key_id
# AWS_SECRET_ACCESS_KEY=replace_with_read_only_secret_access_key

# Public customer registration (/join/<code>). Free email providers are a
# comma-separated list for the email_is_free feature. Phone numbers without a
# country code are read for PHONE_DEFAULT_REGION. The rate limit counts
# non-assisted registrations per IP address within the window.
FREE_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com,live.com,aol.com,proton.me,protonmail.com,gmx.com,mail.com,yandex.com,zoho.com
PHONE_DEFAULT_REGION=KE
JOIN_RATE_LIMIT=10
JOIN_RATE_WINDOW_SECONDS=3600

# Demo data (`.\scripts\dev.ps1 seed-demo`). Every demo account uses this
# password; it must meet the password policy (12+ characters with upper and
# lower case, a number, and a symbol). Demo emails use @demo.example.com.
# DEMO_PASSWORD=replace_with_a_demo_password

# Firebase Authentication (sign-in, email verification, password resets).
# SalesMesh still decides roles, approval, and sessions. Values come from the
# Firebase console: Project settings > General > Your apps (web app config).
# The web values are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=replace_with_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_project_id
VITE_FIREBASE_APP_ID=replace_with_web_app_id
FIREBASE_PROJECT_ID=replace_with_project_id
# Service-account key (Project settings > Service accounts > Generate new
# private key). It is a secret: keep it OUTSIDE the repository and use forward
# slashes. Docker mounts it read-only at /run/secrets/firebase-admin.json.
FIREBASE_CREDENTIALS_PATH=C:/Users/replace_with_you/secrets/salesmesh-firebase-admin.json
# Frontend API origin; keep localhost hostname consistent for Secure cookies.
VITE_API_URL=http://localhost:8000
# Address shown in the /join privacy notice for data access or deletion requests.
VITE_PRIVACY_CONTACT_EMAIL=privacy@example.com