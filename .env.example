# Phase 1 local PostgreSQL settings. Copy to .env and replace the password.
# These are development defaults, not production credentials.
POSTGRES_DB=salesmesh
POSTGRES_USER=salesmesh_dev
POSTGRES_PASSWORD=replace_with_a_unique_local_password
POSTGRES_PORT=5432

# Phase 2 backend settings. Host/port connect from Windows to the container.
POSTGRES_HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT=5

# A separate database on the same server, using the same local credentials.
# Tests require this name to end in _test and differ from POSTGRES_DB.
TEST_POSTGRES_DB=salesmesh_test

# Phase 3 authentication. Generate the real secret without displaying it:
# backend/.venv/Scripts/python.exe backend/manage.py init-secret
# JWT_SECRET=replace_with_a_generated_secret_of_at_least_32_characters
JWT_ISSUER=salesmesh
JWT_AUDIENCE=salesmesh-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
VERIFICATION_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=30
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_FAILURE_LIMIT=5
ACCOUNT_LOCKOUT_MINUTES=15