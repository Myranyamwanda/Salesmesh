# Production settings for docker-compose.prod.yml (docs/deployment.md).
# On the server: cp .env.production.example .env && chmod 600 .env
# Replace every replace_... value. Never commit the filled-in file.

# --- New for production -------------------------------------------------------
# Public host name; Caddy gets the HTTPS certificate for it. FRONTEND_URL is
# derived from it (https://<DOMAIN>) by docker-compose.prod.yml.
DOMAIN=replace_with_your_name.duckdns.org
# Uvicorn worker processes. Each loads the model (~200-300 MB); 2 suits 2 GB.
BACKEND_WORKERS=2

# --- Database (no published port in production) -------------------------------
POSTGRES_DB=salesmesh
POSTGRES_USER=salesmesh
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_a_generated_password

# --- Secrets (generate on the server; docs/deployment.md step 6) ---------------
# openssl rand -hex 32
JWT_SECRET=replace_with_a_generated_secret_of_at_least_32_characters
# openssl rand 32 | base64 | tr '+/' '-_'   (a Fernet key)
TOTP_ENCRYPTION_KEY=replace_with_a_generated_fernet_key
# Password of every @demo.example.com account created by seed-demo: 12+
# characters with upper and lower case, a number, and a symbol.
DEMO_PASSWORD=replace_with_a_demo_password

# --- Firebase -----------------------------------------------------------------
# Host path of the service-account key; mounted read-only into the backend.
FIREBASE_CREDENTIALS_PATH=/opt/salesmesh/secrets/firebase-admin.json
FIREBASE_PROJECT_ID=replace_with_project_id
# Public web configuration, written into the frontend bundle at build time.
VITE_FIREBASE_API_KEY=replace_with_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_project_id
VITE_FIREBASE_APP_ID=replace_with_web_app_id
# Address shown in the /join privacy notice for data access or deletion requests.
VITE_PRIVACY_CONTACT_EMAIL=replace_with_privacy_contact@example.com

# --- Unchanged from development (listed so the values are visible) -----------
LOG_LEVEL=INFO
JWT_ISSUER=salesmesh
JWT_AUDIENCE=salesmesh-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_FAILURE_LIMIT=5
ACCOUNT_LOCKOUT_MINUTES=15
JOIN_RATE_LIMIT=10
JOIN_RATE_WINDOW_SECONDS=3600
REPUTATION_API_RATE_LIMIT=60
REPUTATION_API_RATE_WINDOW_SECONDS=60
MODEL_SOURCE=local
PHONE_DEFAULT_REGION=KE
# Public resolvers make the real-email (MX) check predictable on a cloud host.
EMAIL_DNS_TIMEOUT_SECONDS=2
EMAIL_DNS_SERVERS=1.1.1.1,8.8.8.8

# Set by docker-compose.prod.yml, do NOT set here: POSTGRES_HOST, POSTGRES_PORT,
# FRONTEND_URL, MODEL_DIR, VITE_API_URL (/api). The refresh cookie is always
# Secure, HttpOnly, SameSite=Strict (unchanged application code).
